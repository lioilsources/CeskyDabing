# Copy to .env (gitignored). Placeholders only, real values stay in .env.
SPARK_HOST=spark.example
# Shared storage root, same path on M2 and SPARK (docs/nfs.md).
DUB_ROOT=/mnt/dabing
# shared | upload (fallback without shared storage)
DUB_SEPARATE_STORAGE=shared
# Optional per-worker override: DUB_SEPARATE_URL, DUB_ASR_URL, DUB_TTS_URL
# SPARK side (deploy/compose.spark.yaml): owner of the shared files and host dirs.
DUB_UID=1000
DUB_GID=1000
DUB_MODELS=../models
DUB_SCRATCH=../scratch
HF_TOKEN=
# LLM for translate: default http://$SPARK_HOST:8080/v1 (AiStack gateway), model openclaw-default
# DUB_LLM_URL=
DUB_LLM_MODEL=openclaw-default
DUB_LLM_KEY=
# TTS: AiStack audio service, default http://$SPARK_HOST:8093 (needs broker service tts)
# DUB_TTS_URL=
DUB_TTS_KEY=
# Declaration the audio service requires to store a cloned voice: own | consented | licensed | synthetic.
# No default on purpose; the owner decides (see docs/tts.md).
DUB_TTS_VOICE_RIGHTS=
DUB_TTS_VOICE_SOURCE=
